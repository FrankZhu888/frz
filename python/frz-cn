    "/system", "/model", "/baseurl", "/web", "/verbose", "/history", "/clear", "/exit", "/quit",
])


def _path_completion_matches(text):
    """补全 @后的路径；含空格路径自动使用单引号，目录可继续补全。"""
    raw = text[1:]
    quote = raw[0] if raw[:1] in ('"', "'") else ""
    if quote:
        raw = raw[1:]
    directory, base = os.path.split(raw)
    read_dir = os.path.expanduser(directory or ".")
    try:
        entries = list(os.scandir(read_dir))
    except OSError:
        return []

    matches = []
    for entry in sorted(entries, key=lambda e: e.name):
        if not base and entry.name.startswith("."):
            continue
        if not entry.name.startswith(base):
            continue
        candidate = os.path.join(directory, entry.name) if directory else entry.name
        try:
            is_dir = entry.is_dir()
        except OSError:
            is_dir = False
        if is_dir:
            candidate += os.sep
        needs_quote = any(c.isspace() for c in candidate)
        active_quote = quote or ("'" if needs_quote else "")
        closing_quote = active_quote if active_quote and not is_dir else ""
        matches.append("@" + active_quote + candidate + closing_quote)
        if len(matches) >= 100:
            break
    return matches


def _completion_matches(buf, text):
    """Tab 补全候选：会话名、斜杠命令，以及 @后的本地路径。"""
    if text.startswith("@"):
        return _path_completion_matches(text)
    if buf.startswith("/resume ") or buf.startswith("/resume\t"):
        return [name for name, _ in list_sessions() if name.startswith(text)]
    if buf.startswith("/") and " " not in buf:
        return [c for c in _REPL_COMMANDS if c.startswith(text)]
    return []


