def _change_directory(target=None):
    """cd 是唯一需要跨命令保留状态的 shell 内建命令。"""
    path = Path(target).expanduser() if target else Path.home()
    try:
        os.chdir(path)
        print(os.getcwd())
    except OSError as e:
        print(stylize(f"cd: {e}", "red"))


def _run_shell_command(command):
    """执行用户显式输入的本地命令；输出不进入模型会话。"""
    print(stylize(f"$ {command}", "gray"), flush=True)
    try:
        result = subprocess.run(command, shell=True, executable="/bin/sh")
        if result.returncode != 0:
            print(stylize(f"[命令退出码: {result.returncode}]", "gray"))
    except KeyboardInterrupt:
        print("\n(命令已中断)")
    except OSError as e:
        print(stylize(f"命令执行失败: {e}", "red"))


def _handle_shell_input(user_input):
    """处理 !命令，以及无需前缀的 ls/pwd/cd；其它输入仍发送给模型。"""
    explicit = user_input.startswith("!")
    command = user_input[1:].strip() if explicit else user_input
    if explicit and not command:
        print("用法: !<系统命令>，例如 !ls -la；单独 ! 不进入持续 shell。")
        return True
    if not explicit:
        first = command.split(None, 1)[0].lower()
        if first not in ("ls", "pwd", "cd"):
            return False

    try:
        parts = shlex.split(command)
    except ValueError as e:
        print(stylize(f"命令解析失败: {e}", "red"))
        return True
    if not parts:
        return True
    if parts[0] == "cd" and len(parts) <= 2:
        if len(parts) == 1:
            _change_directory()
        else:
            _change_directory(parts[1])
    else:
        _run_shell_command(command)
    return True


def _format_history(messages):
    """把消息列表格式化成 /history 要显示的文本（与之前逐条 print 的输出一致）。"""
    out = []
    for m in messages:
        out.append("")
        if m["role"] == "user":
            for line in m["content"].split("\n"):
                out.append(stylize("> ", "green") + line)
            for label in _attachment_labels(m):
                out.append(stylize("> ", "green") + f"[附件: {label}]")
        else:
            out.append(render_markdown(m["content"]))
    return "\n".join(out)


def _page_text(text):
    """长文本交给分页器查看，避免顶穿终端 scrollback 缓冲区。
    优先用 $PAGER，默认 less：-R 透传 ANSI 颜色，-F 不足一屏直接退出，
    -X 退出后内容留在终端里（不进备用屏幕）。非 tty 或没有分页器时直接打印。"""
    if not sys.stdout.isatty():
        print(text)
        return
    cmd = (os.environ.get("PAGER") or "less").split()
    if os.path.basename(cmd[0]) == "less":
        cmd += ["-R", "-F", "-X"]
    try:
        subprocess.run(cmd, input=text.encode("utf-8"))
    except (FileNotFoundError, OSError):
        print(text)


# Tab 补全用的斜杠命令清单（排序后补全菜单更可读）
_REPL_COMMANDS = sorted([
