def repl(session, api_key):
    global VERBOSE
    provider = session["provider"]
    print(f"frz {__version__}  进入会话「{session['name']}」  provider={provider}  model={session['model']}")
    print("输入 /help 查看命令，输入 /exit 保存并退出。\n")

    # 启用 readline：解决两个问题——
    #   1) 裸 input() 走终端规范模式，退格按字节删，中文等多字节字符删不干净；
    #   2) macOS 规范模式单行上限 1024 字节，长输入会被静默截断。
    # 注意 macOS 系统 Python 自带的是 libedit，对宽字符/折行/历史召回的光标计算有
    # bug（表现为删除删不到行首、删完有残留），所以优先使用 gnureadline 包提供的
    # 真正的 GNU readline（pip install gnureadline）；没装则退回系统 readline。
    try:
        import gnureadline as _rl
    except ImportError:
        try:
            import readline as _rl
        except ImportError:
            _rl = None
    if _rl is not None:
        # 开启 bracketed paste：粘贴的多行文本作为整体一次提交（换行插入编辑缓冲区），
        # 否则剩余行会被后续 input() 逐行读走，每一行都误触发一次 API 调用
        try:
            _rl.parse_and_bind("set enable-bracketed-paste on")
        except Exception:
            pass  # libedit 等不支持的实现静默跳过

        # Tab 补全：行首斜杠命令、/resume 后的会话名。
        # 分隔符只留空白：readline 默认分隔符含 - . 等符号，会把
        # session-20260903-110531 这类会话名拆断、只剩最后一段参与补全
        _comp = {"matches": []}  # state>0 的后续调用复用同一份候选

        def _complete(text, state):
            if state == 0:
                _comp["matches"] = _completion_matches(_rl.get_line_buffer(), text)
            try:
                return _comp["matches"][state]
            except IndexError:
                return None

        _rl.set_completer(_complete)
        try:
            _rl.set_completer_delims(" \t\n")
            # macOS 系统 Python 自带的 libedit 与 GNU readline 的按键绑定语法不同
            if _rl.__doc__ and "libedit" in _rl.__doc__:
                _rl.parse_and_bind("bind ^I rl_complete")
            else:
                _rl.parse_and_bind("tab: complete")
        except Exception:
            pass  # 补全设置失败不影响正常使用，只是没有 Tab 补全

    while True:
        try:
            user_input = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n(已中断，正在保存会话...)")
            save_session(session)
            break

        if not user_input:
            continue

        if _handle_shell_input(user_input):
            continue

        if user_input.startswith("/"):
            parts = user_input.split(maxsplit=1)
            cmd = parts[0].lower()
            arg = parts[1].strip() if len(parts) > 1 else ""

            if cmd in ("/exit", "/quit"):
                path = save_session(session)
                print(f"会话已保存到 {path}" if path else "(空会话，未保存)")
                break

            elif cmd == "/help":
                print(HELP_TEXT)

            elif cmd == "/save":
                if arg and arg != session["name"] and session_path(arg).exists():
                    print(f"会话「{arg}」已存在，请换个名字（以免覆盖已有会话）")
                    continue
                if arg:
                    session["name"] = arg
                path = save_session(session, force=True)
                print(f"已保存到 {path}")

            elif cmd == "/rename":
                if not arg:
                    print("用法: /rename <新名字>")
                    continue
                old_name = session["name"]
                old_path = session_path(old_name)
                if not old_path.exists() and not session.get("messages"):
                    # 空会话尚未落盘时无需经过文件重命名，但仍要检查目标冲突。
                    if session_path(arg).exists():
                        print(f"会话「{arg}」已存在，请换个名字")
                    else:
                        session["name"] = arg
                        print(f"已将会话「{old_name}」重命名为「{arg}」")
                    continue
                save_session(session)  # 先把最新内容落盘，再整体改名
                ok, result = rename_session_file(old_name, arg)
                if ok:
                    session["name"] = arg
                    print(f"已将会话「{old_name}」重命名为「{arg}」")
                else:
                    print(result)

            elif cmd == "/resume":
                target = arg
                if not target:
                    # 不带会话名：续聊最近更新的会话（排除当前会话）
                    for name, _ in list_sessions():
                        if name != session["name"]:
                            target = name
                            break
                    if not target:
                        print("没有可续聊的会话。")
                        continue
                save_session(session)
                loaded = load_session(target)
                if loaded is None:
                    print(f"找不到会话「{target}」，输入 /list 查看已有会话。")
                    continue
                previous_provider = provider
                session = loaded
                provider = session["provider"]
                # 同 provider 可保留命令行 Key；跨 provider 找不到新 Key 时禁止复用旧 Key。
                api_key = _resumed_api_key(previous_provider, provider, api_key)
                if not api_key:
                    env_name = ENV_KEY_NAMES.get(provider, "对应环境变量")
                    print(stylize(f"[注意] 找不到 {provider} 的 API Key（{env_name}），已阻止后续请求", "red"))
                print(f"已切换到会话「{session['name']}」 provider={provider} model={session['model']}")

            elif cmd == "/edit":
                text = _edit_in_editor()
                if text:
                    kb = len(text.encode("utf-8")) // 1024
                    if kb > 100:
                        print(f"(编辑器内容共 {kb} KB，将整体发送)")
                    send_message(session, text, provider, api_key)
                else:
                    print("(内容为空，已取消)")
                continue

            elif cmd == "/export":
                if not session["messages"]:
                    print("(当前会话还没有对话内容，不导出)")
                    continue
                path, overwritten = export_session(session, arg or None)
                print(f"已导出到 {path}" + ("（已覆盖旧文件）" if overwritten else ""))

            elif cmd == "/list":
                sessions = list_sessions()
                if not sessions:
                    print("(还没有保存过任何会话)")
                for name, data in sessions:
                    n_msgs = len(data.get("messages", []))
                    print(f"  - {name}  [{data.get('provider')}/{data.get('model')}]  "
                          f"{n_msgs} 条消息  更新于 {data.get('updated_at')}")

            elif cmd == "/new":
                new_name = arg or default_session_name()
                if session_path(new_name).exists():
                    print(f"会话「{new_name}」已存在，请换个名字或用 /resume 恢复。")
                    continue
                save_session(session)
                # base_url 一并带走：openai_responses 等 provider 没有它无法发起调用
                session = new_session(new_name, provider, session["model"], session["system_prompt"],
                                      base_url=session.get("base_url"),
                                      web_search=session.get("web_search", False))
                print(f"已开启新会话「{new_name}」")

            elif cmd == "/system":
                if arg:
                    session["system_prompt"] = arg
                    print("已更新 system prompt。")
                else:
                    print(f"当前 system prompt: {session['system_prompt'] or '(未设置)'}")

            elif cmd == "/model":
                if arg:
                    session["model"] = arg
                    print(f"已切换模型为: {arg}")
                else:
                    print(f"当前模型: {session['model']}")

            elif cmd == "/baseurl":
                if arg:
                    session["base_url"] = arg
                    print(f"已设置 base url 为: {arg}")
                else:
                    print(f"当前 base url: {session.get('base_url') or '(未设置，使用 provider 默认地址)'}")

            elif cmd == "/web":
                if provider != "openai_responses":
                    print("联网搜索目前仅支持 openai_responses provider。")
                elif not arg:
                    enabled = session.get("web_search", False)
                    print(f"当前联网搜索: {'on（模型自动决策）' if enabled else 'off'}")
                elif arg.lower() in ("on", "off"):
                    session["web_search"] = arg.lower() == "on"
                    if session["web_search"]:
                        print("已开启联网搜索，由模型自动决策。")
                    else:
                        print("已关闭联网搜索。")
                else:
                    print("用法: /web [on|off]")

            elif cmd == "/verbose":
                if not arg:
                    print(f"当前详细调试日志: {'on（输出到 stderr）' if VERBOSE else 'off'}")
                elif arg.lower() in ("on", "off"):
                    VERBOSE = arg.lower() == "on"
                    print("已开启详细调试日志，输出到 stderr。" if VERBOSE else "已关闭详细调试日志。")
                else:
                    print("用法: /verbose [on|off]")

            elif cmd == "/history":
                msgs = session["messages"]
                if not msgs:
                    print("(当前会话还没有对话内容)")
                    continue
                if arg:
                    # /history N：只看最近 N 轮（一轮 = 一问一答两条消息）
                    try:
                        n = int(arg)
                        if n <= 0:
                            raise ValueError
                    except ValueError:
                        print("用法: /history [最近N轮]")
                        continue
                    msgs = msgs[-2 * n:]
                    # 对齐到 user 边界，避免从半截对话开始显示
                    while msgs and msgs[0]["role"] != "user":
                        msgs = msgs[1:]
                    if len(msgs) < len(session["messages"]):
                        print(f"(仅显示最近 {n} 轮；完整历史共 {len(session['messages'])} 条消息，"
                              f"/history 查看全部)")
                _page_text(_format_history(msgs))

            elif cmd == "/clear":
                session["messages"] = []
                save_session(session, force=True)  # 空历史也必须覆盖旧文件，避免恢复后旧消息重现
                print("已清空当前会话历史。")

            else:
                print(f"未知命令: {cmd}，输入 /help 查看可用命令。")

            continue

        # 普通用户消息 -> 调用模型
        send_message(session, user_input, provider, api_key)


def send_message(session, user_input, provider, api_key):
    """把一条用户消息（可含 @附件）发给模型；失败/中断时消息不入库。"""
    if not api_key:
        print(stylize(f"[错误] 当前 provider={provider} 没有可用 API Key，已取消发送。", "red"))
        return
    try:
        message = _build_user_message(user_input, provider)
    except (ValueError, OSError) as e:
        print(stylize(f"[附件错误] {e}", "red"))
        return
    session["messages"].append(message)
    for label in _attachment_labels(message):
        print(stylize(f"[附件] {label}", "gray"))
    base_url = session.get("base_url")
    is_streaming = provider in STREAMING_PROVIDERS

    # 等待期间显示转圈指示，首个正文 delta 到达即撤掉
    indicator = ThinkingIndicator()
    indicator.start()
    try:
        if is_streaming:
            print(flush=True)
            stream = StreamRenderer(on_output=indicator.stop)

            def _on_delta(text):
                stream.feed(text)

            def _on_reasoning(_text):
                indicator.set_state(random.choice(ThinkingIndicator._VERBS))

            def _on_search(state):
                if state == "completed":
                    # 搜索完成后进入结果整理阶段；若再次搜索，会重新切回搜索提示。
                    status = random.choice(ThinkingIndicator._VERBS)
                else:
                    status = {
                        "in_progress": "搜索中",
                        "searching": "搜索中",
                        "failed": "搜索失败",
                    }.get(state, "搜索中")
                indicator.set_state(status, force=True)

            reply = call_model(provider, session["messages"], session["system_prompt"],
                                session["model"], api_key, base_url=base_url,
                                on_delta=_on_delta, on_reasoning=_on_reasoning,
                                web_search=session.get("web_search", False), on_search=_on_search)
            stream.finish()
            print()
        else:
            reply = call_model(provider, session["messages"], session["system_prompt"],
                                session["model"], api_key, base_url=base_url)
    except RuntimeError as e:
        print(stylize(f"\n[出错了] {e}", "red"))
        session["messages"].pop()  # 失败的消息不计入历史
        return
    except KeyboardInterrupt:
        # 等待响应/流式输出中途按 Ctrl-C：取消本轮，消息不计入历史，回到输入
        print(stylize("\n[已取消] 本轮请求已被中断", "gray"))
        session["messages"].pop()
        return
    finally:
        indicator.stop()

    if not reply or not reply.strip():
        # 搜索完成但正文为空时不能入库，否则下一轮会携带空 input_text 并连续 400。
        session["messages"].pop()
        print(stylize("\n[出错了] 模型未返回正文，本轮消息未计入历史", "red"))
        return

    session["messages"].append({"role": "assistant", "content": reply})
    if not is_streaming:
        print()
        print(render_markdown(reply))
        print()

    # 每轮自动保存，防止意外退出丢历史
    save_session(session)


_EDIT_HINT = ("# 在下方输入消息（可多行），保存并退出编辑器后发送。\n"
              "# 这两行提示会被自动去掉；内容为空则不发送。\n")


def _edit_in_editor():
    """打开 $VISUAL/$EDITOR（默认 vi）编辑多行消息，返回消息文本；取消或为空返回 None。
    走临时文件而不是终端行缓冲，所以没有单行 1024 字节之类的长度限制，
    瓶颈只在下游的模型上下文窗口和 API 请求体大小。"""
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    fd, path = tempfile.mkstemp(suffix=".md", prefix="frz-edit-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(_EDIT_HINT)
        try:
            rc = subprocess.call(shlex.split(editor) + [path])
        except FileNotFoundError:
            print(f"[出错了] 找不到编辑器: {editor}（可用 export EDITOR=vim 指定）")
            return None
        if rc != 0:
            print("(编辑器异常退出，已取消)")
            return None
        text = Path(path).read_text(encoding="utf-8")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    # 只去掉"未被用户动过"的提示行：不能用"忽略 # 开头行"的粗暴规则，
    # 否则贴的日志里 root 提示符（# iptables -L）这类内容会被误删
    if text.startswith(_EDIT_HINT):
        text = text[len(_EDIT_HINT):]
    return text.strip() or None


