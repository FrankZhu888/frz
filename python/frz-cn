def resolve_model(provider, cli_model, cfg):
    """模型名解析：--model > config 里按 provider 存的 model > 旧版全局 model > 内置默认。
    旧版 config 的全局 "model" 字段只对 config 里的默认 provider 生效——否则切到
    别的 provider 时会拿着上一个 provider 的模型名去调用（404）。"""
    if cli_model:
        return cli_model
    models = cfg.get("models", {})
    if provider in models:
        return models[provider]
    if provider == cfg.get("provider"):
        return cfg.get("model") or DEFAULT_MODELS.get(provider)
    return DEFAULT_MODELS.get(provider)


def resolve_base_url(provider, cli_url, cfg):
    if cli_url:
        return cli_url
    urls = cfg.get("base_urls", {})
    if provider in urls:
        return urls[provider]
    return DEFAULT_BASE_URLS.get(provider)


def resolve_api_key(provider, cli_key, cfg):
    if cli_key:
        return cli_key
    env_name = ENV_KEY_NAMES.get(provider)
    if env_name and os.environ.get(env_name):
        return os.environ[env_name]
    keys = cfg.get("api_keys", {})
    if provider in keys:
        return keys[provider]
    return None


def _resumed_api_key(previous_provider, new_provider, current_key):
    """恢复会话时解析 Key；跨 provider 且无新 Key 时绝不复用旧 Key。"""
    resumed_key = resolve_api_key(new_provider, None, load_config())
    if resumed_key:
        return resumed_key
    if new_provider != previous_provider:
        return None
    # 同 provider 仍允许使用启动时通过 --api-key 传入、未写入配置的 Key。
    return current_key


# argparse 的 help 输出中文化。argparse 内部通过模块级 _() 做翻译（usage: / error 消息等），
# 这里只替换 usage 前缀一个词，其余消息保持英文原样（出错信息不翻译，方便搜索）。
argparse._ = lambda s: {"usage: ": "用法: "}.get(s, s)


class FrzArgumentParser(argparse.ArgumentParser):
    """统一中文化 argparse 帮助：-h 文案 + 分组标题（位置参数/选项）。
    所有子 parser（add_parser 默认沿用父 parser 的类）自动获得同样行为。"""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("add_help", False)
        super().__init__(*args, **kwargs)
        self.add_argument("-h", "--help", action="help", default=argparse.SUPPRESS,
                          help="显示本帮助信息并退出")
        self._positionals.title = "位置参数"
        self._optionals.title = "选项"

    def format_help(self):
        # 主帮助首行放"名称+版本+一句话定位"（子命令帮助不加）
        text = super().format_help()
        if self.prog == "frz":
            text = (f"frz {__version__} — 一个类似 Gemini CLI 的多模型命令行聊天工具"
                    f"（支持 Anthropic / OpenAI / Gemini / OpenAI Responses 协议后端）\n"
                    f"作者: {__author__}\n\n") + text
        return text


