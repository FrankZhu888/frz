调试日志：--verbose 或 FRZ_VERBOSE=1；写入 stderr，不记录 API Key 和请求正文。

model 和 base url 按 provider 分别保存，切换 provider 互不影响。

进入会话后输入 /help 查看斜杠命令（/save /resume /export /edit /history 等），
输入时可用 Tab 补全斜杠命令和 /resume 的会话名。
"""


def build_arg_parser():
    parser = FrzArgumentParser(
        prog="frz",
        # usage 显式换行：argparse 自动折行按字符数算缩进，对中文前缀"用法: "
        # 会少算宽度导致续行对不齐，这里手工对齐（续行缩进 = "用法: frz " 的显示宽度）
        usage="frz [-h] [--provider PROVIDER] [--model MODEL] [--api-key KEY]\n"
              "          [--base-url URL] [--system PROMPT] [--resume NAME] [--web|--no-web]\n"
              "          [--session-name NAME] [--list-sessions] [--verbose] {config,rename,clean} ...",
        description="支持 Anthropic / OpenAI / Gemini / OpenAI Responses 协议四种后端",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="subcommand", title="子命令")

    # config 子命令
    config_p = sub.add_parser("config", help="查看或设置默认配置",
                              description=f"查看或设置默认配置（保存于 {CONFIG_FILE}）")
    config_sub = config_p.add_subparsers(dest="config_action", title="子命令")
    set_p = config_sub.add_parser("set", help="设置默认 provider/model/api-key",
                                  # 同主 parser：手工换行对齐（缩进 = "用法: frz config set " 宽度）
                                  usage="frz config set [-h] [--provider PROVIDER] [--model MODEL]\n"
                                        "                     [--api-key KEY] [--base-url URL]",
                                  description="设置默认 provider/model/api-key"
                                              "（API Key、base url、model 均按 provider 分别保存）")
    set_p.add_argument("--provider", choices=list(CALLERS.keys()), metavar="PROVIDER",
                       help=f"模型后端：{' / '.join(CALLERS)}")
    set_p.add_argument("--model", metavar="MODEL", help="默认模型名称（按 provider 分别保存）")
    set_p.add_argument("--api-key", metavar="KEY", help="对应 provider 的 API Key")
    set_p.add_argument("--base-url", metavar="URL",
                       help="自定义 API base url（openai_responses 等 provider 使用）")
    config_sub.add_parser("show", help="显示当前配置", description="显示当前默认配置")

    # rename 子命令：不进 REPL 直接重命名已保存的会话
    rename_p = sub.add_parser("rename", help="重命名已保存的会话",
                              description=f"重命名 {SESS_DIR} 下已保存的会话")
    rename_p.add_argument("old_name", help="原会话名")
    rename_p.add_argument("new_name", help="新会话名")

    # clean 子命令：删除空会话，以及超过保护期且不被任何会话引用的附件
    sub.add_parser("clean", help="删除空会话及无引用附件",
                   description="删除 0 条消息的空会话，并清理超过 24 小时且不被任何会话引用的附件快照")

    # 默认聊天参数（不加子命令时直接进入聊天）
    parser.add_argument("--provider", choices=list(CALLERS.keys()), metavar="PROVIDER",
                        help=f"使用的模型后端：{' / '.join(CALLERS)}（默认 anthropic）")
    parser.add_argument("--model", metavar="MODEL",
                        help="模型名称，例如 claude-sonnet-4-6 / gpt-4o / gemini-2.5-flash / kimi-k3")
    parser.add_argument("--api-key", metavar="KEY",
                        help="API Key（也可用环境变量或 config 提供，见下方说明）")
    parser.add_argument("--base-url", metavar="URL",
                        help="自定义 API base url（openai_responses 等 provider 需要，比如火山方舟地址）")
    parser.add_argument("--system", metavar="PROMPT", help="system prompt")
    web_group = parser.add_mutually_exclusive_group()
    web_group.add_argument("--web", dest="web_search", action="store_true",
                           help="允许 openai_responses 模型按需求自动联网搜索")
    web_group.add_argument("--no-web", dest="web_search", action="store_false",
                           help="关闭联网搜索")
    parser.set_defaults(web_search=None)
    parser.add_argument("--resume", metavar="NAME", help="恢复指定名字的会话")
    parser.add_argument("--session-name", metavar="NAME", help="新会话的名字（不指定则自动生成）")
    parser.add_argument("--list-sessions", action="store_true", help="列出所有已保存的会话后退出")
    parser.add_argument("--verbose", action="store_true",
                        help="输出 HTTP/SSE 调试日志到 stderr（也可用 FRZ_VERBOSE=1）")
    parser.add_argument("--version", action="version",
                        version=f"frz {__version__} {_PLAT}  by {__author__}")

    return parser


def main():
    global VERBOSE
    ensure_dirs()
    parser = build_arg_parser()
    args = parser.parse_args()
    if args.verbose:
        VERBOSE = True
    _debug(f"frz {__version__}; platform={_PLAT}; verbose enabled")
    cfg = load_config()

    if args.subcommand == "config":
        if args.config_action == "set":
            if args.provider:
                cfg["provider"] = args.provider
            if args.model:
                cfg.setdefault("models", {})[args.provider or cfg.get("provider", "anthropic")] = args.model
            if args.api_key:
                cfg.setdefault("api_keys", {})[args.provider or cfg.get("provider", "anthropic")] = args.api_key
            if args.base_url:
                cfg.setdefault("base_urls", {})[args.provider or cfg.get("provider", "anthropic")] = args.base_url
            save_config(cfg)
            print(f"配置已保存到 {CONFIG_FILE}")
        else:
            print(json.dumps(cfg, ensure_ascii=False, indent=2))
        return

    if args.subcommand == "rename":
        ok, result = rename_session_file(args.old_name, args.new_name)
        if ok:
            print(f"已将会话「{args.old_name}」重命名为「{args.new_name}」({result})")
        else:
            print(f"[错误] {result}")
            sys.exit(1)
        return

    if args.subcommand == "clean":
        removed = [name for name, data in list_sessions() if not data.get("messages")]
        for name in removed:
            session_path(name).unlink()
            print(f"已删除空会话: {name}")
        if not removed:
            print("(没有空会话)")
        try:
            freed, count, skipped = _clean_unreferenced_attachments()
        except RuntimeError as e:
            print(stylize(f"[注意] {e}", "red"))
            return
        if count:
            print(f"已清理 {count} 个无引用附件，释放 {_format_size(freed)}")
        if skipped:
            print(f"(保留 {skipped} 个 24 小时内的无引用附件)")
        if not count and not skipped:
            print("(没有可清理的无引用附件)")
        return

    if args.list_sessions:
        sessions = list_sessions()
        if not sessions:
            print("(还没有保存过任何会话)")
        for name, data in sessions:
            n_msgs = len(data.get("messages", []))
            print(f"  - {name}  [{data.get('provider')}/{data.get('model')}]  "
                  f"{n_msgs} 条消息  更新于 {data.get('updated_at')}")
        return

    provider = args.provider or cfg.get("provider", "anthropic")

    session = None
    if args.resume:
        session = load_session(args.resume)
        if session is None:
            print(f"[错误] 找不到会话「{args.resume}」，用 --list-sessions 查看已有会话。")
            sys.exit(1)
        # repl 始终按会话自己的 provider 调用模型，所以 provider/key 也以会话为准，
        # 避免 config 默认 provider 与会话不一致时拿错 key（401）
        provider = session["provider"]

    model = resolve_model(provider, args.model, cfg)
    base_url = resolve_base_url(provider, args.base_url, cfg)
    api_key = resolve_api_key(provider, args.api_key, cfg)

    if not api_key:
        env_name = ENV_KEY_NAMES.get(provider, "对应的环境变量")
        print(f"[错误] 找不到 {provider} 的 API Key。请用以下任意方式提供：")
        print(f"  1) --api-key 你的密钥")
        print(f"  2) export {env_name}=你的密钥")
        print(f"  3) frz config set --provider {provider} --api-key 你的密钥")
        sys.exit(1)

    if provider in DEFAULT_BASE_URLS and not base_url:
        print(f"[错误] provider={provider} 需要 base_url，请用 --base-url 指定，"
              f"或 frz config set --provider {provider} --base-url 地址")
        sys.exit(1)

    if session is not None:
        # --resume：应用命令行覆盖项
        if args.system:
            session["system_prompt"] = args.system
        if args.model:
            session["model"] = args.model
        if args.base_url:
            session["base_url"] = args.base_url
        elif "base_url" not in session:
            session["base_url"] = base_url
        if args.web_search is not None:
            session["web_search"] = args.web_search
    else:
        name = args.session_name or default_session_name()
        if session_path(name).exists():
            print(f"[错误] 会话「{name}」已存在；请换用 --session-name，或用 --resume 恢复。")
            sys.exit(1)
        session = new_session(name, provider, model, args.system or "", base_url=base_url,
                              web_search=args.web_search)

    repl(session, api_key)


if __name__ == "__main__":
    main()
