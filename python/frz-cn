VERBOSE = os.environ.get("FRZ_VERBOSE", "").strip().lower() in {"1", "true", "yes", "on"}
_DEBUG_MAX_CHARS = 12000


def _debug(message):
    if VERBOSE:
        print(f"[debug] {message}", file=sys.stderr, flush=True)


def _debug_json(value):
    text = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if len(text) > _DEBUG_MAX_CHARS:
        return text[:_DEBUG_MAX_CHARS] + f"...<truncated {len(text) - _DEBUG_MAX_CHARS} chars>"
    return text


def _debug_url(url):
    # Gemini 等 URL 可能带 key 查询参数；用户信息及常见凭据参数必须脱敏。
    url = re.sub(r"(https?://)[^/@\s]+@", r"\1<redacted>@", url)
    return re.sub(r"([?&](?:key|api[-_]?key|access_token)=)[^&]*",
                  r"\1<redacted>", url, flags=re.IGNORECASE)


def _debug_response_headers(headers):
    if not VERBOSE or not headers:
        return
    # 只记录排障所需的白名单字段，避免输出 Cookie 等无关敏感信息。
    for name in ("content-type", "x-request-id", "request-id", "x-tt-logid",
                 "trace-id", "x-trace-id", "retry-after"):
        value = headers.get(name)
        if value:
            _debug(f"response {name}: {value}")


def _upstream_error_detail(evt):
    response = evt.get("response")
    if not isinstance(response, dict):
        response = {}
    error = response.get("error") or evt.get("error")
    parts = []
    if response.get("id"):
        parts.append(f"response_id={response['id']}")
    if isinstance(error, dict):
        for key in ("code", "type", "message", "param"):
            if error.get(key):
                parts.append(f"{key}={error[key]}")
    elif error:
        parts.append(str(error))
    # 某些上游只返回状态或非标准错误结构，不能再折叠成 unknown error。
    return "; ".join(parts) if parts else _debug_json(evt)

