#!/usr/bin/env python3
"""
frz - 一个类似 Gemini CLI 的多模型命令行聊天工具。

特性：
  - 支持 Anthropic (Claude) / OpenAI / Google Gemini / OpenAI Responses 协议四种后端
  - 核心仅使用 Python 标准库（urllib），无必装第三方依赖
  - 回复带 Markdown 终端渲染（标题/粗体/列表/表格/代码块等）；可选安装 pygments 让代码块获得语法高亮
  - 代码块内的手绘框线图自动重对齐右边界，修正模型数错 CJK 宽度画歪的框
  - 会话可保存 / 恢复 / 列出 / 导出 Markdown，历史保存在 ~/.frz/sessions/*.json
  - REPL 内支持斜杠命令: /help /save /rename /resume /list /new /export /edit /system /model /baseurl /history /clear /exit
  - REPL 输入增强：Tab 补全（斜杠命令/会话名/@路径）、/edit 编辑器多行输入、
    /history 长输出自动分页、/resume 不带名字直接续聊最近的会话
  - REPL 本地命令：!命令，以及直接输入 ls / pwd / cd；输出仅在本地显示，不进入模型上下文
  - openai_responses 支持 @文本/@图片附件，可使用文件名、相对路径或绝对路径；
    文本/图片单文件上限分别为 2/10 MiB，单次总量 15 MiB；快照独立存储，会话仅保存引用
  - openai_responses 新会话默认允许模型按需求自动联网搜索，可用 /web on|off 或 --web/--no-web 控制

用法示例：
  # 直接开始一个新会话（默认使用 Anthropic claude-sonnet-4-6）
  frz --api-key sk-ant-xxxx

  # 指定 provider / model
  frz --provider openai --model gpt-4o --api-key sk-xxxx

  # 用环境变量提供 key（更安全，不会出现在 shell 历史里）
  export ANTHROPIC_API_KEY=sk-ant-xxxx
  frz

  # 恢复上次的会话
  frz --resume my-session

  # 列出所有已保存的会话
  frz --list-sessions

  # 把默认 provider/model/api-key 写进配置文件，以后不用每次传
  frz config set --provider anthropic --model claude-sonnet-4-6 --api-key sk-ant-xxxx

  # 对接 Responses API 协议的服务（例如火山方舟 Ark），支持真正的流式打字机输出
  export ARK_API_KEY=ark-xxxx
  frz --provider openai_responses --model kimi-k3 \\
      --base-url https://ark.cn-beijing.volces.com/api/plan/v3
  # 也可以把 base-url/model 存进配置，以后只需 --provider openai_responses
  frz config set --provider openai_responses \\
      --model kimi-k3 --base-url https://ark.cn-beijing.volces.com/api/plan/v3 --api-key ark-xxxx
"""

