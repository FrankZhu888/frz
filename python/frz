def resolve_model(provider, cli_model, cfg):
    """Model resolution: --model > per-provider model in config > legacy global
    model > built-in default. The legacy global "model" config field only applies
    to the default provider in config — otherwise switching providers would call
    the API with the previous provider's model name (404)."""
    if cli_model:
        return cli_model
    models = cfg.get("models", {})
    if provider in models:
        return models[provider]
    if provider == cfg.get("provider"):
        return cfg.get("model") or DEFAULT_MODELS.get(provider)
    return DEFAULT_MODELS.get(provider)


def resolve_base_url(provider, cli_url, cfg):
    if cli_url:
        return cli_url
    urls = cfg.get("base_urls", {})
    if provider in urls:
        return urls[provider]
    return DEFAULT_BASE_URLS.get(provider)


def resolve_api_key(provider, cli_key, cfg):
    if cli_key:
        return cli_key
    env_name = ENV_KEY_NAMES.get(provider)
    if env_name and os.environ.get(env_name):
        return os.environ[env_name]
    keys = cfg.get("api_keys", {})
    if provider in keys:
        return keys[provider]
    return None


def _resumed_api_key(previous_provider, new_provider, current_key):
    """Resolve a resumed session key without leaking keys across providers."""
    resumed_key = resolve_api_key(new_provider, None, load_config())
    if resumed_key:
        return resumed_key
    if new_provider != previous_provider:
        return None
    # A same-provider key supplied only through --api-key remains valid.
    return current_key


# Localize argparse help output. argparse translates internally via module-level
# _() (usage: / error messages etc.); here only the usage prefix is replaced,
# everything else stays in English (error text is easier to search verbatim).
argparse._ = lambda s: s


class FrzArgumentParser(argparse.ArgumentParser):
    """Unified argparse help: -h wording + group titles (positional/optional).
    Sub-parsers (add_parser reuses the parent's class by default) inherit the
    same behavior automatically."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("add_help", False)
        super().__init__(*args, **kwargs)
        self.add_argument("-h", "--help", action="help", default=argparse.SUPPRESS,
                          help="show this help message and exit")
        self._positionals.title = "positional arguments"
        self._optionals.title = "options"

    def format_help(self):
        # Main help gets a "name+version+tagline" header line (sub-command help doesn't)
        text = super().format_help()
        if self.prog == "frz":
            text = (f"frz {__version__} — a Gemini-CLI-style multi-provider chat client"
                    f" (Anthropic / OpenAI / Gemini / OpenAI Responses)\n"
                    f"author: {__author__}\n\n") + text
        return text


EPILOG = f"""\
Examples:
  frz                                       start chatting with the default config
  frz --provider openai --model gpt-4o      pick a provider / model
  frz --resume my-session                   resume a saved session
  frz --web                                 allow the model to search when needed
  frz --no-web                              disable web search for a new session
  frz --list-sessions                       list all saved sessions and exit
  frz config set --provider anthropic --api-key sk-ant-xxxx
                                            persist defaults to ~/.frz/config.json
  frz rename old new                        rename a saved session
  frz clean                                 delete empty sessions and unreferenced attachments

API key precedence: --api-key > environment variable > config file
  anthropic=ANTHROPIC_API_KEY  openai=OPENAI_API_KEY
  gemini=GEMINI_API_KEY        openai_responses=ARK_API_KEY

Debug logging: --verbose or FRZ_VERBOSE=1; logs go to stderr without API keys
or conversation request bodies.

Models and base urls are stored per provider and never leak across providers.

Once inside a session, type /help for slash commands (/save /resume /export
/edit /history etc.); Tab completes commands, /resume session names and @paths.
"""


def build_arg_parser():
    parser = FrzArgumentParser(
        prog="frz",
        usage="frz [-h] [--provider PROVIDER] [--model MODEL] [--api-key KEY]\n"
              "          [--base-url URL] [--system PROMPT] [--resume NAME] [--web|--no-web]\n"
              "          [--session-name NAME] [--list-sessions] [--verbose] [--version]\n"
              "          {config,rename,clean} ...",
        description="supports Anthropic / OpenAI / Gemini / OpenAI Responses backends",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="subcommand", title="subcommands")

    # config subcommand
    config_p = sub.add_parser("config", help="view or set default config",
                              description=f"view or set default config (stored in {CONFIG_FILE})")
    config_sub = config_p.add_subparsers(dest="config_action", title="subcommands")
    set_p = config_sub.add_parser("set", help="set default provider/model/api-key",
                                  usage="frz config set [-h] [--provider PROVIDER] [--model MODEL]\n"
                                        "                     [--api-key KEY] [--base-url URL]",
                                  description="set default provider/model/api-key "
                                              "(API keys, base urls and models are stored per provider)")
    set_p.add_argument("--provider", choices=list(CALLERS.keys()), metavar="PROVIDER",
                       help=f"model backend: {' / '.join(CALLERS)}")
    set_p.add_argument("--model", metavar="MODEL", help="default model name (stored per provider)")
    set_p.add_argument("--api-key", metavar="KEY", help="API key for the provider")
    set_p.add_argument("--base-url", metavar="URL",
                       help="custom API base url (used by openai_responses and similar providers)")
    config_sub.add_parser("show", help="show current config", description="show current default config")

    # rename subcommand: rename a saved session without entering the REPL
    rename_p = sub.add_parser("rename", help="rename a saved session",
                              description=f"rename a session saved under {SESS_DIR}")
    rename_p.add_argument("old_name", help="current session name")
    rename_p.add_argument("new_name", help="new session name")

    # clean subcommand: empty sessions and unreferenced attachments past the grace period
    sub.add_parser("clean", help="delete empty sessions and unreferenced attachments",
                   description="delete empty sessions and unreferenced attachment snapshots older than 24 hours")

    # Default chat arguments (no subcommand -> enter chat)
    parser.add_argument("--provider", choices=list(CALLERS.keys()), metavar="PROVIDER",
                        help=f"model backend: {' / '.join(CALLERS)} (default anthropic)")
    parser.add_argument("--model", metavar="MODEL",
                        help="model name, e.g. claude-sonnet-4-6 / gpt-4o / gemini-2.5-flash / kimi-k3")
    parser.add_argument("--api-key", metavar="KEY",
                        help="API key (can also come from env var or config, see below)")
    parser.add_argument("--base-url", metavar="URL",
                        help="custom API base url (required by openai_responses and similar providers)")
    parser.add_argument("--system", metavar="PROMPT", help="system prompt")
    web_group = parser.add_mutually_exclusive_group()
    web_group.add_argument("--web", dest="web_search", action="store_true",
                           help="allow openai_responses models to search when needed")
    web_group.add_argument("--no-web", dest="web_search", action="store_false",
                           help="disable web search")
    parser.set_defaults(web_search=None)
    parser.add_argument("--resume", metavar="NAME", help="resume the named session")
    parser.add_argument("--session-name", metavar="NAME", help="name for the new session (auto-generated if omitted)")
    parser.add_argument("--list-sessions", action="store_true", help="list saved sessions and exit")
    parser.add_argument("--verbose", action="store_true",
                        help="write HTTP/SSE debug logs to stderr (or set FRZ_VERBOSE=1)")
    parser.add_argument("--version", action="version",
                        version=f"frz {__version__} {_PLAT}  by {__author__}")

    return parser


def main():
    global VERBOSE
    ensure_dirs()
    parser = build_arg_parser()
    args = parser.parse_args()
    if args.verbose:
        VERBOSE = True
    _debug(f"frz {__version__}; platform={_PLAT}; verbose enabled")
    cfg = load_config()

    if args.subcommand == "config":
        if args.config_action == "set":
            if args.provider:
                cfg["provider"] = args.provider
            if args.model:
                cfg.setdefault("models", {})[args.provider or cfg.get("provider", "anthropic")] = args.model
            if args.api_key:
                cfg.setdefault("api_keys", {})[args.provider or cfg.get("provider", "anthropic")] = args.api_key
            if args.base_url:
                cfg.setdefault("base_urls", {})[args.provider or cfg.get("provider", "anthropic")] = args.base_url
            save_config(cfg)
            print(f"config saved to {CONFIG_FILE}")
        else:
            print(json.dumps(cfg, ensure_ascii=False, indent=2))
        return

    if args.subcommand == "rename":
        ok, result = rename_session_file(args.old_name, args.new_name)
        if ok:
            print(f'renamed session "{args.old_name}" to "{args.new_name}" ({result})')
        else:
            print(f"[error] {result}")
            sys.exit(1)
        return

    if args.subcommand == "clean":
        removed = [name for name, data in list_sessions() if not data.get("messages")]
        for name in removed:
            session_path(name).unlink()
            print(f"deleted empty session: {name}")
        if not removed:
            print("(no empty sessions)")
        try:
            freed, count, skipped = _clean_unreferenced_attachments()
        except RuntimeError as e:
            print(stylize(f"[note] {e}", "red"))
            return
        if count:
            print(f"removed {count} unreferenced attachments, freed {_format_size(freed)}")
        if skipped:
            print(f"(kept {skipped} unreferenced attachments within the 24-hour grace period)")
        if not count and not skipped:
            print("(no unreferenced attachments to clean)")
        return

    if args.list_sessions:
        sessions = list_sessions()
        if not sessions:
            print("(no saved sessions yet)")
        for name, data in sessions:
            n_msgs = len(data.get("messages", []))
            print(f"  - {name}  [{data.get('provider')}/{data.get('model')}]  "
                  f"{n_msgs} messages  updated {data.get('updated_at')}")
        return

    provider = args.provider or cfg.get("provider", "anthropic")

    session = None
    if args.resume:
        session = load_session(args.resume)
        if session is None:
            print(f"[error] session \"{args.resume}\" not found; see --list-sessions.")
            sys.exit(1)
        # The REPL always calls the model with the session's own provider, so the
        # provider/key are re-resolved against it — avoids picking the wrong key
        # (401) when the config default provider differs from the session's
        provider = session["provider"]

    model = resolve_model(provider, args.model, cfg)
    base_url = resolve_base_url(provider, args.base_url, cfg)
    api_key = resolve_api_key(provider, args.api_key, cfg)

    if not api_key:
        env_name = ENV_KEY_NAMES.get(provider, "corresponding env var")
        print(f"[error] no API key found for {provider}. Provide it via:")
        print(f"  1) --api-key YOUR_KEY")
        print(f"  2) export {env_name}=YOUR_KEY")
        print(f"  3) frz config set --provider {provider} --api-key YOUR_KEY")
        sys.exit(1)

    if provider in DEFAULT_BASE_URLS and not base_url:
        print(f"[error] provider={provider} requires a base url; pass --base-url, "
              f"or frz config set --provider {provider} --base-url URL")
        sys.exit(1)

    if session is not None:
        # --resume: apply command-line overrides
        if args.system:
            session["system_prompt"] = args.system
        if args.model:
            session["model"] = args.model
        if args.base_url:
            session["base_url"] = args.base_url
        elif "base_url" not in session:
            session["base_url"] = base_url
        if args.web_search is not None:
            session["web_search"] = args.web_search
    else:
        name = args.session_name or default_session_name()
        if session_path(name).exists():
            print(f'[error] session "{name}" already exists; pick another name or use --resume')
            sys.exit(1)
        session = new_session(name, provider, model, args.system or "", base_url=base_url,
                              web_search=args.web_search)

    repl(session, api_key)


if __name__ == "__main__":
    main()
