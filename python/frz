def _change_directory(target=None):
    """cd is the only shell builtin whose state persists across commands."""
    path = Path(target).expanduser() if target else Path.home()
    try:
        os.chdir(path)
        print(os.getcwd())
    except OSError as e:
        print(stylize(f"cd: {e}", "red"))


def _run_shell_command(command):
    """Run an explicit local command; output is never added to model context."""
    print(stylize(f"$ {command}", "gray"), flush=True)
    try:
        result = subprocess.run(command, shell=True, executable="/bin/sh")
        if result.returncode != 0:
            print(stylize(f"[exit status: {result.returncode}]", "gray"))
    except KeyboardInterrupt:
        print("\n(command interrupted)")
    except OSError as e:
        print(stylize(f"command failed: {e}", "red"))


def _handle_shell_input(user_input):
    """Handle !command and bare ls/pwd/cd; leave all other input for the model."""
    explicit = user_input.startswith("!")
    command = user_input[1:].strip() if explicit else user_input
    if explicit and not command:
        print("usage: !<command>, e.g. !ls -la (a lone ! does not enter a persistent shell)")
        return True
    if not explicit:
        first = command.split(None, 1)[0].lower()
        if first not in ("ls", "pwd", "cd"):
            return False
    try:
        parts = shlex.split(command)
    except ValueError as e:
        print(stylize(f"cannot parse command: {e}", "red"))
        return True
    if not parts:
        return True
    if parts[0] == "cd" and len(parts) <= 2:
        _change_directory(parts[1] if len(parts) == 2 else None)
    else:
        _run_shell_command(command)
    return True


def _format_history(messages):
    """Format the message list into the text shown by /history."""
    out = []
    for m in messages:
        out.append("")
        if m["role"] == "user":
            for line in m["content"].split("\n"):
                out.append(stylize("> ", "green") + line)
            for label in _attachment_labels(m):
                out.append(stylize("> ", "green") + f"[Attachment: {label}]")
        else:
            out.append(render_markdown(m["content"]))
    return "\n".join(out)


def _page_text(text):
    """View long text through a pager so it doesn't blow through the terminal
    scrollback buffer. Prefers $PAGER, defaults to less: -R passes ANSI colors,
    -F quits if one screen, -X leaves content on screen after exit (no alternate
    screen). Falls back to plain print when not a tty or no pager is available."""
    if not sys.stdout.isatty():
        print(text)
        return
    cmd = (os.environ.get("PAGER") or "less").split()
    if os.path.basename(cmd[0]) == "less":
        cmd += ["-R", "-F", "-X"]
    try:
        subprocess.run(cmd, input=text.encode("utf-8"))
    except (FileNotFoundError, OSError):
        print(text)


# Slash commands offered for Tab completion (sorted for a readable completion menu)
_REPL_COMMANDS = sorted([
    "/help", "/save", "/rename", "/resume", "/list", "/new", "/export", "/edit",
    "/system", "/model", "/baseurl", "/web", "/verbose", "/history", "/clear", "/exit", "/quit",
])


def _path_completion_matches(text):
    """Complete @ paths, quoting spaces and allowing directory traversal."""
    raw = text[1:]
    quote = raw[0] if raw[:1] in ('"', "'") else ""
    if quote:
        raw = raw[1:]
    directory, base = os.path.split(raw)
    read_dir = os.path.expanduser(directory or ".")
    try:
        entries = list(os.scandir(read_dir))
    except OSError:
        return []
    matches = []
    for entry in sorted(entries, key=lambda e: e.name):
        if not base and entry.name.startswith("."):
            continue
        if not entry.name.startswith(base):
            continue
        candidate = os.path.join(directory, entry.name) if directory else entry.name
        try:
            is_dir = entry.is_dir()
        except OSError:
            is_dir = False
        if is_dir:
            candidate += os.sep
        needs_quote = any(c.isspace() for c in candidate)
        active_quote = quote or ("'" if needs_quote else "")
        closing_quote = active_quote if active_quote and not is_dir else ""
        matches.append("@" + active_quote + candidate + closing_quote)
        if len(matches) >= 100:
            break
    return matches


def _completion_matches(buf, text):
    """Complete session names, slash commands, and @ paths."""
    if text.startswith("@"):
        return _path_completion_matches(text)
    if buf.startswith("/resume ") or buf.startswith("/resume\t"):
        return [name for name, _ in list_sessions() if name.startswith(text)]
    if buf.startswith("/") and " " not in buf:
        return [c for c in _REPL_COMMANDS if c.startswith(text)]
    return []


