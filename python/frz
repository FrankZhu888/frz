def _format_history(messages):
    """Format the message list into the text shown by /history."""
    out = []
    for m in messages:
        out.append("")
        if m["role"] == "user":
            for line in m["content"].split("\n"):
                out.append(stylize("> ", "green") + line)
        else:
            out.append(render_markdown(m["content"]))
    return "\n".join(out)


def _page_text(text):
    """View long text through a pager so it doesn't blow through the terminal
    scrollback buffer. Prefers $PAGER, defaults to less: -R passes ANSI colors,
    -F quits if one screen, -X leaves content on screen after exit (no alternate
    screen). Falls back to plain print when not a tty or no pager is available."""
    if not sys.stdout.isatty():
        print(text)
        return
    cmd = (os.environ.get("PAGER") or "less").split()
    if os.path.basename(cmd[0]) == "less":
        cmd += ["-R", "-F", "-X"]
    try:
        subprocess.run(cmd, input=text.encode("utf-8"))
    except (FileNotFoundError, OSError):
        print(text)


# Slash commands offered for Tab completion (sorted for a readable completion menu)
_REPL_COMMANDS = sorted([
    "/help", "/save", "/rename", "/resume", "/list", "/new", "/export", "/edit",
    "/system", "/model", "/baseurl", "/history", "/clear", "/exit", "/quit",
])


def _completion_matches(buf, text):
    """Tab completion candidates: session names after /resume; command names
    while typing a command at line start."""
    if buf.startswith("/resume ") or buf.startswith("/resume\t"):
        return [name for name, _ in list_sessions() if name.startswith(text)]
    if buf.startswith("/") and " " not in buf:
        return [c for c in _REPL_COMMANDS if c.startswith(text)]
    return []


