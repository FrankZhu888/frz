# --------------------------------------------------------------------------
# Basic utilities
# --------------------------------------------------------------------------

def ensure_dirs():
    SESS_DIR.mkdir(parents=True, exist_ok=True)


def load_config():
    if CONFIG_FILE.exists():
        try:
            return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            return {}
    return {}


def save_config(cfg):
    ensure_dirs()
    CONFIG_FILE.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except OSError:
        pass


def session_path(name):
    safe = "".join(c for c in name if c.isalnum() or c in ("-", "_", ".")) or "session"
    return SESS_DIR / f"{safe}.json"


def list_sessions():
    ensure_dirs()
    sessions = []
    for f in sorted(SESS_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True):
        try:
            data = json.loads(f.read_text(encoding="utf-8"))
            sessions.append((f.stem, data))
        except (json.JSONDecodeError, OSError):
            continue
    return sessions


def save_session(session, force=False):
    """Save the session; returns the path, or None if skipped.
    Empty sessions (0 messages) are skipped unless force=True, so the automatic
    saves before /resume, /new and /exit don't litter the directory with empty
    placeholder files; explicit /save passes force=True."""
    if not force and not session.get("messages"):
        return None
    ensure_dirs()
    session["updated_at"] = datetime.now().isoformat(timespec="seconds")
    path = session_path(session["name"])
    path.write_text(json.dumps(session, ensure_ascii=False, indent=2), encoding="utf-8")
    return path


def default_session_name():
    # Name carries date+time so it's recognizable in the list, e.g. session-20260907-153012
    return datetime.now().strftime("session-%Y%m%d-%H%M%S")


def rename_session_file(old_name, new_name):
    """Rename a session file from old_name to new_name; returns (ok, message)."""
    old_path = session_path(old_name)
    new_path = session_path(new_name)
    if not old_path.exists():
        return False, f'session "{old_name}" not found'
    if new_path != old_path and new_path.exists():
        return False, f'session "{new_name}" already exists, pick another name'
    data = json.loads(old_path.read_text(encoding="utf-8"))
    data["name"] = new_name
    data["updated_at"] = datetime.now().isoformat(timespec="seconds")
    new_path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    if new_path != old_path:
        old_path.unlink()
    return True, new_path


def load_session(name):
    path = session_path(name)
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def new_session(name, provider, model, system_prompt, base_url=None):
    return {
        "name": name,
        "provider": provider,
        "model": model,
        "base_url": base_url,  # only used by some providers (e.g. openai_responses)
        "system_prompt": system_prompt,
        "created_at": datetime.now().isoformat(timespec="seconds"),
        "updated_at": datetime.now().isoformat(timespec="seconds"),
        "messages": [],  # [{role: "user"|"assistant", content: str}]
    }


def export_session(session, dest=None):
    """Export the session to a Markdown file; returns (path, overwritten).
    Message contents are already Markdown, so they are dumped verbatim under
    role headings; metadata goes into a leading blockquote."""
    lines = [f"# {session['name']}", ""]
    lines.append(f"> provider={session['provider']}  model={session['model']}  "
                 f"created {session.get('created_at', '?')}")
    if session.get("system_prompt"):
        lines.append(f"> system: {session['system_prompt']}")
    for m in session["messages"]:
        lines += ["", f"## {'User' if m['role'] == 'user' else 'Assistant'}", "", m["content"]]

    path = Path(dest).expanduser() if dest else EXPORT_DIR / f"{session['name']}.md"
    if not path.suffix:
        path = path.with_suffix(".md")
    path.parent.mkdir(parents=True, exist_ok=True)
    overwritten = path.exists()
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path, overwritten


# --------------------------------------------------------------------------
# API calls (each vendor's HTTP API differs; unified as
# call(messages, system, model, api_key) -> str)
# --------------------------------------------------------------------------

def _http_post_json(url, headers, payload, timeout=300):
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {body}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"network error: {e.reason}") from e


def call_anthropic(messages, system, model, api_key, max_tokens=8192, base_url=None, on_delta=None, on_reasoning=None):
    url = "https://api.anthropic.com/v1/messages"
    headers = {
        "content-type": "application/json",
        "x-api-key": api_key,
        "anthropic-version": "2023-06-01",
    }
    payload = {
        "model": model,
        "max_tokens": max_tokens,
        "messages": [{"role": m["role"], "content": m["content"]} for m in messages],
    }
    if system:
        payload["system"] = system
    result = _http_post_json(url, headers, payload)
    parts = result.get("content", [])
    return "".join(p.get("text", "") for p in parts if p.get("type") == "text")


def call_openai(messages, system, model, api_key, max_tokens=8192, base_url=None, on_delta=None, on_reasoning=None):
    url = (base_url.rstrip("/") + "/chat/completions") if base_url else "https://api.openai.com/v1/chat/completions"
    headers = {
        "content-type": "application/json",
        "authorization": f"Bearer {api_key}",
    }
    msgs = []
    if system:
        msgs.append({"role": "system", "content": system})
    msgs.extend({"role": m["role"], "content": m["content"]} for m in messages)
    # Newer models (o1/o3 etc.) only accept max_completion_tokens; the legacy
    # max_tokens parameter is rejected with 400
    payload = {"model": model, "messages": msgs, "max_completion_tokens": max_tokens}
    result = _http_post_json(url, headers, payload)
    return result["choices"][0]["message"]["content"]


def call_gemini(messages, system, model, api_key, max_tokens=8192, base_url=None, on_delta=None, on_reasoning=None):
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
    headers = {"content-type": "application/json"}
    contents = []
    for m in messages:
        role = "model" if m["role"] == "assistant" else "user"
        contents.append({"role": role, "parts": [{"text": m["content"]}]})
    payload = {
        "contents": contents,
        "generationConfig": {"maxOutputTokens": max_tokens},
    }
    if system:
        payload["systemInstruction"] = {"parts": [{"text": system}]}
    result = _http_post_json(url, headers, payload)
    candidates = result.get("candidates", [])
    if not candidates:
        return "(model returned no content, possibly blocked by safety filters)"
    parts = candidates[0].get("content", {}).get("parts", [])
    return "".join(p.get("text", "") for p in parts)


def call_openai_responses(messages, system, model, api_key, max_tokens=8192, base_url=None, on_delta=None, on_reasoning=None):
    """
    Speaks the OpenAI Responses API protocol (POST {base_url}/responses), SSE streaming.
    Protocol shape adapted from Open WebUI's Pipe function:
      - request body uses `input` (role + typed content parts, input_text/input_image)
        and `instructions` (i.e. the system prompt)
      - events: response.output_text.delta / response.reasoning_summary_text.delta /
                response.completed / response.failed
    Many vendors (e.g. Volcengine Ark) expose OpenAI-compatible capability through
    this protocol, hence the dedicated provider.
    on_delta: optional callback invoked per text delta, for the typewriter effect.
    Returns the full concatenated reply text (reasoning not included).
    """
    if not base_url:
        raise RuntimeError("openai_responses provider requires base_url; pass --base-url.")

    url = base_url.rstrip("/") + "/responses"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
    }

    input_items = [
        {"role": m["role"], "content": [{"type": "input_text", "text": m["content"]}]}
        for m in messages
    ]
    payload = {"model": model, "input": input_items, "stream": True}
    if system:
        payload["instructions"] = system

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")

    full_text = []
    current_event = None
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").rstrip("\r\n")
                if not line:
                    continue

                if line.startswith("event:"):
                    current_event = line[len("event:"):].strip()
                    continue

                if not line.startswith("data:"):
                    continue

                data_str = line[len("data:"):].strip()
                if not data_str or data_str == "[DONE]":
                    continue

                try:
                    evt = json.loads(data_str)
                except json.JSONDecodeError:
                    continue

                etype = current_event or evt.get("type")

                if etype == "response.output_text.delta":
                    delta_text = evt.get("delta", "")
                    if delta_text:
                        full_text.append(delta_text)
                        if on_delta:
                            on_delta(delta_text)

                elif etype == "response.reasoning_summary_text.delta":
                    # Reasoning deltas don't count as reply content; forwarded via
                    # on_reasoning as a "still thinking" heartbeat for the spinner.
                    if on_reasoning:
                        on_reasoning(evt.get("delta", ""))

                elif etype == "response.failed":
                    err = evt.get("response", {}).get("error", {}).get("message", "unknown error")
                    raise RuntimeError(f"upstream error: {err}")

                elif etype == "response.completed":
                    break

    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {body}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"network error: {e.reason}") from e

    return "".join(full_text)


CALLERS = {
    "anthropic": call_anthropic,
    "openai": call_openai,
    "gemini": call_gemini,
    "openai_responses": call_openai_responses,
}


def call_model(provider, messages, system, model, api_key, base_url=None, on_delta=None, on_reasoning=None):
    if provider not in CALLERS:
        raise ValueError(f"unknown provider: {provider}")
    return CALLERS[provider](messages, system, model, api_key, base_url=base_url,
                             on_delta=on_delta, on_reasoning=on_reasoning)


# --------------------------------------------------------------------------
# Terminal Markdown rendering
#   Lightweight stdlib rendering: headings/bold/italic/inline code/lists/quotes/
#   hr/code blocks. With pygments installed (pip install pygments), code blocks
#   get syntax highlighting. Falls back to plain text when piped, TERM=dumb,
#   or NO_COLOR is set.
# --------------------------------------------------------------------------

try:  # optional dependency: pygments is only used for syntax highlighting
    from pygments import format as _pg_format
    from pygments import lex as _pg_lex
    from pygments.formatters import Terminal256Formatter
    from pygments.lexers import TextLexer, get_lexer_by_name
    from pygments.token import Token as _PgToken
    from pygments.util import ClassNotFound as _PgClassNotFound
    HAS_PYGMENTS = True
except ImportError:
    HAS_PYGMENTS = False


def _detect_color_support():
    if os.environ.get("FRZ_FORCE_COLOR"):
        return True
    if os.environ.get("NO_COLOR") is not None:
        return False
    if os.environ.get("TERM", "dumb") in ("", "dumb"):
        return False
    return sys.stdout.isatty()


USE_COLOR = _detect_color_support()

_ANSI = {
    "reset": "\033[0m",
    "bold": "\033[1m",
    "dim": "\033[2m",
    "italic": "\033[3m",
    "red": "\033[31m",
    "green": "\033[32m",
    "gray": "\033[90m",
    # Inline code (commands/args/paths): blue-violet rgb(177,185,249), taken from
    # Claude Code's suggestion color, truecolor direct. Foreground only, keeps it plain.
    "inline_code": "\033[38;2;177;185;249m",
}


def stylize(text, *styles):
    if not USE_COLOR or not text:
        return text
    return "".join(_ANSI[s] for s in styles) + text + _ANSI["reset"]


# Inline elements: code > bold > italic, in match order (first match wins).
# Underscore forms get word-boundary guards to avoid mangling snake_case;
# asterisk forms follow CommonMark flanking rules (inner side of * must not be
# whitespace) so that 2 * 3 * 4 doesn't render as italic.
_INLINE_RE = re.compile(
    r"(`[^`\n]+`)"
    r"|(\*\*[^\s*](?:[^\n*]*[^\s*])?\*\*)"
    r"|((?<!\w)__[^_\n]+?__(?!\w))"
    r"|(\*[^\s*](?:[^\n*]*[^\s*])?\*)"
    r"|((?<!\w)_[^_\n]+?_(?!\w))"
)

_HEADING_RE = re.compile(r"^\s{0,3}#{1,6}\s+(.*)$")
_HR_RE = re.compile(r"^\s{0,3}(-{3,}|\*{3,}|_{3,})\s*$")
_UL_RE = re.compile(r"^(\s*)[-*+]\s+(.*)$")
_OL_RE = re.compile(r"^(\s*)(\d{1,3})[.)]\s+(.*)$")
_FENCE_RE = re.compile(r"^\s{0,3}```([^`]*)\s*$")

# Tables: a candidate header row is held pending until the next line confirms as
# a separator (|---|---|), avoiding false positives from stray | in prose.
_TABLE_SEP_RE = re.compile(r"^\s*\|?\s*:?-{2,}:?\s*(?:\|\s*:?-{2,}:?\s*)+\|?\s*$")
_ANSI_STRIP_RE = re.compile(r"\033\[[0-9;]*m")


def _is_table_row(line):
    s = line.strip()
    return s.startswith("|") and s.count("|") >= 2


def _split_table_row(line):
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    # Expand tabs to a fixed 4 spaces: tabs jump to multiples of 8 in the terminal,
    # making width unpredictable; after expansion, width math matches the display
    return [c.strip().replace("\t", "    ") for c in s.split("|")]


def _col_align(cell):
    cell = cell.strip()
    left, right = cell.startswith(":"), cell.endswith(":")
    if left and right:
        return "center"
    if right:
        return "right"
    return "left"


def _disp_width(s):
    """Display width: strip ANSI escapes, then count terminal columns (CJK wide
    chars take 2 columns). Terminals render by grapheme cluster, where a compound
    sequence occupies a single emoji slot; counting per codepoint skews tables,
    so cluster rules apply:
      - ZWJ (U+200D) glues multiple emoji into one cluster; later chars in the
        cluster don't count (👨‍💻 is 2 columns total)
      - Skin-tone modifiers (U+1F3FB..U+1F3FF) attach to the previous emoji, zero width
      - Combining marks (Mn/Me, e.g. U+0301 accents, U+20E3 keycap) and format
        controls (Cf) are zero width
      - VS16 (U+FE0F) promotes a preceding 1-column char to a 2-column emoji
        presentation (✈️); VS15 (U+FE0E) forces text presentation, width unchanged"""
    s = _ANSI_STRIP_RE.sub("", s)
    width = 0
    last_one_col = False  # whether the previous counted char was 1 column (VS16/ZWJ adjust)
    in_zwj = False
    for ch in s:
        cp = ord(ch)
        if cp == 0x200D:  # ZWJ: zero width, merges the next char into this cluster
            in_zwj = True
            continue
        if cp == 0xFE0F:  # VS16: force emoji presentation; a 1-col base renders as 2 cols
            if last_one_col:
                width += 1
                last_one_col = False
            continue
        if cp == 0xFE0E:  # VS15: force text presentation, width unchanged
            continue
        if 0x1F3FB <= cp <= 0x1F3FF:  # emoji skin-tone modifier: zero width
            continue
        if unicodedata.category(ch) in ("Mn", "Me", "Cf"):  # combining/format: zero width
            continue
        if in_zwj:
            # Post-ZWJ chars join the cluster and aren't counted; if the base was
            # only 1 column (e.g. a narrow base not already promoted by VS16),
            # pad the cluster to 2 columns
            in_zwj = False
            if last_one_col:
                width += 1
                last_one_col = False
            continue
        w = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        width += w
        last_one_col = w == 1
    return width


def _pad_cell(s, width, align):
    gap = width - _disp_width(s)
    if gap <= 0:
        return s
    if align == "right":
        return " " * gap + s
    if align == "center":
        left = gap // 2
        return " " * left + s + " " * (gap - left)
    return s + " " * gap


def render_inline(line):
    """Render inline Markdown elements (bold/italic/inline code) within one line."""
    if not USE_COLOR:
        return line

    def _sub(m):
        code, bold1, bold2, it1, it2 = m.groups()
        if code:
            return stylize(code[1:-1], "inline_code")
        if bold1 or bold2:
            return stylize((bold1 or bold2)[2:-2], "bold")
        it = it1 or it2
        return stylize(it[1:-1], "italic")

    return _INLINE_RE.sub(_sub, line)


def render_line(line):
    """Render one non-code-block line of Markdown (heading/list/quote/hr + inline)."""
    m = _HEADING_RE.match(line)
    if m:
        # Heading keeps the default foreground (follows terminal theme), bold only
        return stylize(m.group(1), "bold")
    if _HR_RE.match(line):
        return stylize("─" * 40, "gray")
    stripped = line.lstrip()
    if stripped.startswith(">"):
        indent = line[: len(line) - len(stripped)]
        return indent + stylize("▎", "gray") + " " + render_inline(stripped[1:].lstrip())
    m = _UL_RE.match(line)
    if m:
        return m.group(1) + "• " + render_inline(m.group(2))
    m = _OL_RE.match(line)
    if m:
        return m.group(1) + m.group(2) + ". " + render_inline(m.group(3))
    return render_inline(line)


def _pick_pygments_style():
    """Guess light/dark terminal background from COLORFGBG, pick a readable style
    (defaults to dark)."""
    cfb = os.environ.get("COLORFGBG", "")
    if ";" in cfb:
        try:
            bg = int(cfb.split(";")[-1])
            if bg in (7, 15):  # white/light-gray background
                return "default"
        except ValueError:
            pass
    return "monokai"


# Some pygments styles (e.g. monokai) ship their own background color which looks
# bad over the terminal background; strip the 256/truecolor background codes and
# keep only the foreground.
def _strip_pygments_bg(text):
    text = re.sub(r";48;5;\d+", "", text)
    text = re.sub(r";48;2;\d+;\d+;\d+", "", text)
    return re.sub(r"\033\[48;[25];[\d;]*m", "", text)


def _demote_compound_number_tokens(tokens):
    """Demote pseudo-number tokens inside "number+separator+number" compound
    fragments to plain text. bash and other lexers have no concept of IPs, dates,
    times, MACs or versions, so they color parts of 192.168.1.1, 2026/09/08,
    10:00:01, 52:54:00:1a:2b:3c as number literals (purple in monokai), which
    looks like a rendering bug.
    Rule: joined consecutive tokens must match number(separator number){2,} —
    at least two separators required, sparing real numbers like 10/3 or 16:9.
    Processing is per line: once a compound fragment is demoted on a line
    (typically a log/timestamp line), stray bare numbers on that line (e.g. day
    and year in ctime) are demoted too, keeping the line visually consistent."""
    # Group tokens by line (tokens may contain \n), then process per line
    lines, cur = [], []
    for t in tokens:
        cur.append(t)
        if "\n" in t[1]:
            lines.append(cur)
            cur = []
    if cur:
        lines.append(cur)

    out = []
    for line in lines:
        processed, demoted_any = _demote_line(line)
        if demoted_any:
            # Line-level consistency: demote stray bare numbers as well
            processed = [
                (_PgToken.Text, v) if (t in _PgToken.Literal.Number and re.fullmatch(r"\d+", v)) else (t, v)
                for t, v in processed
            ]
        out.extend(processed)
    return out


def _demote_line(tokens):
    """Demote compound number fragments within a single line;
    returns (tokens, whether anything was demoted)."""
    out = []
    demoted_any = False
    i, n = 0, len(tokens)
    while i < n:
        ttype, value = tokens[i]
        if ttype in _PgToken.Literal.Number and re.fullmatch(r"\d+(\.\d+)?", value):
            # Glue following hex+separator tokens to see if they form a compound fragment.
            # Charset: a-f covers MAC addresses; - covers ISO dates and UUIDs;
            # t/T covers the ISO 8601 T separator (2026-09-08T10:00:01)
            j = i + 1
            acc = value
            while j < n and re.fullmatch(r"[0-9a-fA-FtT./:-]+", tokens[j][1]):
                acc += tokens[j][1]
                j += 1
            if re.fullmatch(r"[0-9a-fA-FtT]+([./:-][0-9a-fA-FtT]+){2,}", acc):
                out.extend((_PgToken.Text, tokens[k][1]) for k in range(i, j))
                demoted_any = True
                i = j
                continue
        out.append((ttype, value))
        i += 1
    return out, demoted_any


# Prompt prefix of shell session blocks ([user@host ~]# / user@host:~$). The bash
# lexer doesn't understand prompts: [ ] would be colored red as Operator and the
# command after # would be grayed out as a comment, so prompts are handled separately.
_SHELL_SESSION_LANGS = {"bash", "sh", "shell", "zsh", "console", "shell-session", ""}
_PROMPT_RE = re.compile(
    r"^(\s*(?:\[[\w.\-]+@[\w.\-]+[^\]]*\]|[\w.\-]+@[\w.\-]+:[^\n]*?)[#$]\s*)(.*)$"
)


def _lex_shell_session(code, lexer):
    """Per-line handling of shell session blocks: prompt prefix stays plain text,
    the command after #/$ still gets bash highlighting."""
    out = []
    for line in code.split("\n"):
        m = _PROMPT_RE.match(line)
        if m:
            out.append((_PgToken.Text, m.group(1)))
            if m.group(2):
                out.extend(_pg_lex(m.group(2), lexer))
        elif line:
            out.extend(_pg_lex(line, lexer))
        out.append((_PgToken.Text, "\n"))
    return out


def _highlight_code(code, lang):
    """Highlight code with pygments, demoting IP/date/time/version fragments and
    stripping the style's own background color. Code blocks containing shell
    prompts use session mode so prompts aren't miscolored."""
    try:
        lexer = get_lexer_by_name(lang) if lang else TextLexer()
    except _PgClassNotFound:
        lexer = TextLexer()
    is_shell = (lang or "").lower() in _SHELL_SESSION_LANGS
    if is_shell and any(_PROMPT_RE.match(l) for l in code.split("\n")):
        # Session mode lexes line by line; pygments' ensurenl=True (default) adds
        # a newline to every fragment, which would stack with the \n this module
        # appends per line and produce phantom blank lines, so use an
        # ensurenl=False lexer here
        try:
            session_lexer = get_lexer_by_name(lang, ensurenl=False) if lang else TextLexer(ensurenl=False)
        except _PgClassNotFound:
            session_lexer = TextLexer(ensurenl=False)
        tokens = _lex_shell_session(code, session_lexer)
    else:
        tokens = list(_pg_lex(code, lexer))
    tokens = _demote_compound_number_tokens(tokens)
    formatter = Terminal256Formatter(style=_pick_pygments_style())
    return _strip_pygments_bg(_pg_format(tokens, formatter))


# --------------------------------------------------------------------------
# ASCII box-art realignment in code blocks
#   Models draw ┌─┐│└─┘ diagrams by "mentally" counting CJK widths and are often
#   off by 1-2 columns, leaving ragged right edges (the classic symptom: no emoji
#   or special chars, yet the right border is still crooked). This realigns box
#   lines in untagged/text code blocks by padding every vertical edge rightward
#   to the group's widest column. It only inserts spaces/─ and never deletes
#   content, so even a misfire can't corrupt the diagram.
# --------------------------------------------------------------------------

# Box-drawing chars with "vertical edge" semantics; ─ ┬ ┴ ┼ are horizontal/crossing
_BOX_VBARS = frozenset("│┌┐└┘├┤")
# Only realign blocks with these language tags (untagged is the most common form
# of model-drawn diagrams), avoiding box chars inside e.g. python string literals
_BOX_ART_LANGS = {"", "text", "txt", "plain"}
# Max column spread allowed for edges at the same level: beyond that the boxes
# are intentionally different widths (or an anomalous line sneaked in), and
# forcing alignment would deform the whole diagram — better to keep it as drawn
_BOX_EDGE_TOLERANCE = 4


def _box_edges(line):
    """Return [(char_index, display_col)] of all vertical-edge chars in the line,
    display columns starting at 0. Lines containing tabs return None: tabs jump
    to multiples of 8 in the terminal, making column math unpredictable."""
    if "\t" in line:
        return None
    edges = []
    col = 0
    for i, ch in enumerate(line):
        if ch in _BOX_VBARS:
            edges.append((i, col))
        col += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return edges


def _align_box_edge(group, level):
    """Align each line's (-level)-th vertical edge from the right to one display
    column (level=-1 is the outermost right edge). Only pushes edges rightward
    (insert spaces before an edge; insert ─ for horizontal borders), never deletes."""
    particip = []
    for idx, line in enumerate(group):
        edges = _box_edges(line)
        # level=-1 needs at least two edges (left+right, excludes ├─ tree lines);
        # level=-2 needs at least three (with two, the 2nd-from-right is the left border)
        if edges is not None and len(edges) >= 1 - level:
            particip.append((idx, edges[level]))
    if len(particip) < 2:
        return group
    cols = [col for _, (_, col) in particip]
    if max(cols) - min(cols) > _BOX_EDGE_TOLERANCE:
        return group
    target = max(cols)
    out = list(group)
    for idx, (ci, col) in particip:
        gap = target - col
        if gap <= 0:
            continue
        line = out[idx]
        # Horizontal borders (┌──┐/└──┘) get ─ to stay continuous; content lines get spaces
        fill = "─" if ci > 0 and line[ci - 1] == "─" else " "
        out[idx] = line[:ci] + fill * gap + line[ci:]
    return out


def _realign_group(group):
    """Realign vertical edges within one box group.
    Fully uniform structure (same edge count on every line, e.g. several identical
    side-by-side boxes): align every edge level from innermost to outermost —
    aligning an inner edge pushes outer edges right, so deepest first, outermost last.
    Mixed structure (nested boxes / out-of-box annotations, where the same from-right
    level means different things on different lines): align only the two outermost
    right-edge levels; deeper levels risk mismapping and are left to the spread guard."""
    counts = {len(_box_edges(l)) for l in group}
    if len(counts) == 1:
        n_edges = counts.pop()
        for level in range(-(n_edges - 1), 0):
            group = _align_box_edge(group, level)
    else:
        group = _align_box_edge(group, -2)
        group = _align_box_edge(group, -1)
    return group


def _realign_box_art(code):
    """Realign hand-drawn box diagrams in a code block; a run of consecutive box
    lines (>= 3 lines) forms one box group."""
    lines = [l.rstrip() for l in code.split("\n")]
    out = []
    i, n = 0, len(lines)
    while i < n:
        if _box_edges(lines[i]):
            j = i
            while j < n and _box_edges(lines[j]):
                j += 1
            group = lines[i:j]
            if len(group) >= 3:
                group = _realign_group(group)
            out.extend(group)
            i = j
        else:
            out.append(lines[i])
            i += 1
    return "\n".join(out)


class MarkdownRenderer:
    """Line-by-line Markdown renderer. Code blocks and tables are accumulated
    before one-shot formatting: code until the closing fence (for whole-block
    highlighting), tables until the last row (for column alignment)."""

    def __init__(self):
        self._in_code = False
        self._code_lang = ""
        self._code_lines = []
        self._table_pending = None  # candidate header row, awaiting separator confirmation
        self._in_table = False
        self._table_rows = []
        self._table_aligns = []

    def feed_line(self, line):
        """Feed one line; returns content to print, or None to hold back
        (fence lines, or accumulating a code block / table)."""
        out = []

        # Table state machine (| inside code blocks doesn't trigger tables)
        if not self._in_code:
            if self._table_pending is not None:
                if _TABLE_SEP_RE.match(line):
                    self._in_table = True
                    self._table_rows = [self._table_pending]
                    self._table_aligns = [_col_align(c) for c in _split_table_row(line)]
                    self._table_pending = None
                    return None
                out.append(render_line(self._table_pending))
                self._table_pending = None
            if self._in_table:
                if _is_table_row(line):
                    self._table_rows.append(line)
                    return None
                out.append(self._render_table())
                self._in_table = False
                self._table_rows = []

        # Code block fence
        m = _FENCE_RE.match(line)
        if m:
            if self._in_code:
                self._in_code = False
                out.append(self._render_code())
                self._code_lines = []
            else:
                self._in_code = True
                self._code_lang = m.group(1).strip()
                self._code_lines = []
            return "\n".join(out) or None
        if self._in_code:
            self._code_lines.append(line)
            return "\n".join(out) or None

        # Candidate table header: hold pending, check if next line is a separator
        if _is_table_row(line):
            self._table_pending = line
            return "\n".join(out) or None

        out.append(render_line(line))
        return "\n".join(out)

    def flush(self):
        """Called at end of input: render any pending table or unclosed code block."""
        out = []
        if self._table_pending is not None:
            out.append(render_line(self._table_pending))
            self._table_pending = None
        if self._in_table:
            out.append(self._render_table())
            self._in_table = False
            self._table_rows = []
        if self._in_code:
            self._in_code = False
            if self._code_lines:
                out.append(self._render_code())
        return "\n".join(out) or None

    def _render_table(self):
        rows = [_split_table_row(r) for r in self._table_rows]
        ncols = max(len(r) for r in rows)
        rows = [r + [""] * (ncols - len(r)) for r in rows]
        aligns = (self._table_aligns + ["left"] * ncols)[:ncols]
        rendered = [[render_inline(c) for c in r] for r in rows]
        widths = [max(_disp_width(r[i]) for r in rendered) for i in range(ncols)]
        segs = ["─" * (w + 2) for w in widths]  # +2 for the space padding on both sides

        def _border(left, mid, right):
            return stylize(left + mid.join(segs) + right, "gray")

        def _row(cells, cell_style=None):
            parts = []
            for i in range(ncols):
                c = cells[i]
                if cell_style:
                    c = stylize(c, cell_style)
                parts.append(_pad_cell(c, widths[i], aligns[i]))
            bar = stylize("│", "gray")
            return bar + " " + (" " + bar + " ").join(parts) + " " + bar

        # Fully enclosed box: top/bottom borders + separators between header and
        # each row (Claude Code style)
        lines = [_border("┌", "┬", "┐")]
        lines.append(_row(rendered[0], "bold"))
        lines.append(_border("├", "┼", "┤"))
        for i, r in enumerate(rendered[1:]):
            if i:
                lines.append(_border("├", "┼", "┤"))
            lines.append(_row(r))
        lines.append(_border("└", "┴", "┘"))
        return "\n".join(lines)

    def _render_code(self):
        code = "\n".join(self._code_lines)
        if (self._code_lang or "").lower() in _BOX_ART_LANGS:
            # Hand-drawn diagrams are often ragged from CJK width miscounts; realign first
            code = _realign_box_art(code)
        bar = stylize("▎", "gray")
        if USE_COLOR and HAS_PYGMENTS:
            rendered = _highlight_code(code, self._code_lang).rstrip("\n")
            return "\n".join(f"{bar} {l}" for l in rendered.split("\n"))
        return "\n".join(f"{bar} {l}" for l in code.split("\n")) if code else ""


def render_markdown(text):
    """Render a whole Markdown text into a terminal string."""
    renderer = MarkdownRenderer()
    out = []
    for line in text.split("\n"):
        rendered = renderer.feed_line(line)
        if rendered is not None:
            out.append(rendered)
    tail = renderer.flush()
    if tail is not None:
        out.append(tail)
    return "\n".join(out)


class StreamRenderer:
    """Line-buffered renderer for streaming output: renders only complete lines
    (Markdown syntax closes per line), balancing real-timeness with correctness —
    markers split across deltas (e.g. `**bo` + `ld**`) are still handled correctly."""

    def __init__(self):
        self._renderer = MarkdownRenderer()
        self._buf = ""

    def feed(self, text):
        self._buf += text
        while "\n" in self._buf:
            line, self._buf = self._buf.split("\n", 1)
            self._emit(line)

    def finish(self):
        if self._buf:
            self._emit(self._buf)
            self._buf = ""
        tail = self._renderer.flush()
        if tail is not None:
            print(tail, flush=True)

    def _emit(self, line):
        rendered = self._renderer.feed_line(line)
        if rendered is not None:
            print(rendered, flush=True)


class ThinkingIndicator:
    """Animated indicator while waiting for the model (refreshed from a thread,
    doesn't block network reads). Style replicates Claude Code's spinner:
    ✻ asterisk + random verb + shimmer sweep (base blue rgb(147,165,255), hot
    spot rgb(177,195,255), from its theme palette). stop() is called on the first
    text delta or when the request ends, erasing the indicator line."""

    _GLYPH = "✻"
    # Random "cute verbs" picked on reasoning deltas (cf. Claude Code's Vibing/Pondering)
    _VERBS = ["Thinking", "Pondering", "Mulling", "Brewing", "Wondering",
              "Deliberating", "Computing", "Searching", "Weaving", "Wandering"]
    _BASE = "\033[38;2;147;165;255m"    # claudeBlue_FOR_SYSTEM_SPINNER
    _HOT = "\033[38;2;177;195;255m"     # claudeBlueShimmer_FOR_SYSTEM_SPINNER
    _RESET = "\033[0m"
    _SHIMMER_WIDTH = 4  # width of the sweeping hot spot, in characters

    def __init__(self):
        self._stop = threading.Event()
        self._thread = None
        self._state = "Waiting"
        self._t0 = 0.0

    def start(self):
        if not sys.stdout.isatty():
            return
        self._t0 = time.monotonic()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def set_state(self, state):
        # Switch from "Waiting" to a random thinking verb on the first reasoning delta
        if self._state == "Waiting":
            self._state = state

    def _shimmer(self, text, frame):
        """Whole line in blue with a brighter blob sweeping left-to-right
        (Claude Code's signature effect)."""
        if not USE_COLOR:
            return text
        n = len(text)
        cycle = n + self._SHIMMER_WIDTH
        pos = frame % cycle
        out = []
        for i, ch in enumerate(text):
            in_hot = pos <= i < pos + self._SHIMMER_WIDTH
            out.append((self._HOT if in_hot else self._BASE) + ch)
        return "".join(out) + self._RESET

    def _run(self):
        frame = 0
        while not self._stop.wait(0.12):
            elapsed = int(time.monotonic() - self._t0)
            ts = f"{elapsed // 60}m {elapsed % 60}s" if elapsed >= 60 else f"{elapsed}s"
            text = f"{self._GLYPH} {self._state} {ts}"
            sys.stdout.write("\r" + self._shimmer(text, frame) + "\033[K")
            sys.stdout.flush()
            frame += 1

    def stop(self):
        self._stop.set()
        if self._thread is not None:
            self._thread.join()
            self._thread = None
            sys.stdout.write("\r\033[K")  # erase the indicator line
            sys.stdout.flush()


