def send_message(session, user_input, provider, api_key):
    """Send one user message to the model and render the reply;
    on failure/interruption the message is not recorded."""
    session["messages"].append({"role": "user", "content": user_input})
    base_url = session.get("base_url")
    is_streaming = provider in STREAMING_PROVIDERS

    # Spinner while waiting; dismissed on the first text delta
    indicator = ThinkingIndicator()
    indicator.start()
    try:
        if is_streaming:
            print(flush=True)
            stream = StreamRenderer()

            def _on_delta(text):
                indicator.stop()
                stream.feed(text)

            def _on_reasoning(_text):
                indicator.set_state(random.choice(ThinkingIndicator._VERBS))

            reply = call_model(provider, session["messages"], session["system_prompt"],
                                session["model"], api_key, base_url=base_url,
                                on_delta=_on_delta, on_reasoning=_on_reasoning)
            stream.finish()
            print()
        else:
            reply = call_model(provider, session["messages"], session["system_prompt"],
                                session["model"], api_key, base_url=base_url)
    except RuntimeError as e:
        print(stylize(f"\n[error] {e}", "red"))
        session["messages"].pop()  # failed message is not recorded
        return
    except KeyboardInterrupt:
        # Ctrl-C while waiting/streaming: cancel this round, drop the message
        print(stylize("\n[cancelled] request interrupted", "gray"))
        session["messages"].pop()
        return
    finally:
        indicator.stop()

    session["messages"].append({"role": "assistant", "content": reply})
    if not is_streaming:
        print()
        print(render_markdown(reply))
        print()

    # Auto-save every round so an unexpected exit doesn't lose history
    save_session(session)


_EDIT_HINT = ("# Type your message below (multi-line OK). It is sent when you\n"
              "# save and exit the editor. These two lines are removed automatically;\n"
              "# empty content cancels.\n")


def _edit_in_editor():
    """Open $VISUAL/$EDITOR (default vi) to compose a multi-line message; returns
    the message text, or None when cancelled/empty. Goes through a temp file
    rather than terminal line buffering, so there is no 1024-byte canonical-mode
    limit — the only bounds are the model's context window and API body size."""
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    fd, path = tempfile.mkstemp(suffix=".md", prefix="frz-edit-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(_EDIT_HINT)
        try:
            rc = subprocess.call(shlex.split(editor) + [path])
        except FileNotFoundError:
            print(f"[error] editor not found: {editor} (set it via export EDITOR=vim)")
            return None
        if rc != 0:
            print("(editor exited abnormally, cancelled)")
            return None
        text = Path(path).read_text(encoding="utf-8")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    # Only strip the hint lines if they are exactly as written: a blanket
    # "ignore lines starting with #" rule would eat log content such as
    # root prompts (# iptables -L)
    if text.startswith(_EDIT_HINT):
        text = text[len(_EDIT_HINT):]
    return text.strip() or None


def repl(session, api_key):
    provider = session["provider"]
    print(f"frz {__version__}  session \"{session['name']}\"  provider={provider}  model={session['model']}")
    print("Type /help for commands, /exit to save and quit.\n")

    # Enable readline, which solves two problems:
    #   1) bare input() uses the terminal's canonical mode where backspace erases
    #      by byte, mangling multi-byte characters (e.g. CJK);
    #   2) macOS canonical mode caps a line at 1024 bytes, silently truncating
    #      long input.
    # Note macOS system Python ships libedit, whose cursor math is buggy with
    # wide chars / wrapping / history recall (erase stops before line start,
    # leftovers after deletion), so prefer real GNU readline from the gnureadline
    # package (pip install gnureadline); fall back to system readline otherwise.
    try:
        import gnureadline as _rl
    except ImportError:
        try:
            import readline as _rl
        except ImportError:
            _rl = None
    if _rl is not None:
        # Enable bracketed paste: pasted multi-line text is submitted as a whole
        # (newlines go into the edit buffer); otherwise remaining lines would be
        # read by subsequent input() calls, each wrongly triggering an API call
        try:
            _rl.parse_and_bind("set enable-bracketed-paste on")
        except Exception:
            pass  # silently skip on implementations without support (e.g. libedit)

        # Tab completion: slash commands at line start, session names after /resume.
        # Delimiters are whitespace only: readline's default delimiters include
        # - . etc., which would split names like session-20260903-110531 and
        # complete only the last segment
        _comp = {"matches": []}  # state>0 calls reuse the same candidates

        def _complete(text, state):
            if state == 0:
                _comp["matches"] = _completion_matches(_rl.get_line_buffer(), text)
            try:
                return _comp["matches"][state]
            except IndexError:
                return None

        _rl.set_completer(_complete)
        try:
            _rl.set_completer_delims(" \t\n")
            # macOS system Python ships libedit, whose key-binding syntax differs
            # from GNU readline
            if _rl.__doc__ and "libedit" in _rl.__doc__:
                _rl.parse_and_bind("bind ^I rl_complete")
            else:
                _rl.parse_and_bind("tab: complete")
        except Exception:
            pass  # failure here only means no Tab completion

    while True:
        try:
            user_input = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n(interrupted, saving session...)")
            save_session(session)
            break

        if not user_input:
            continue

        if user_input.startswith("/"):
            parts = user_input.split(maxsplit=1)
            cmd = parts[0].lower()
            arg = parts[1].strip() if len(parts) > 1 else ""

            if cmd in ("/exit", "/quit"):
                path = save_session(session)
                print(f"session saved to {path}" if path else "(empty session, not saved)")
                break

            elif cmd == "/help":
                print(HELP_TEXT)

            elif cmd == "/save":
                if arg and arg != session["name"] and session_path(arg).exists():
                    print(f'session "{arg}" already exists, pick another name'
                          f" (to avoid overwriting it)")
                    continue
                if arg:
                    session["name"] = arg
                path = save_session(session, force=True)
                print(f"saved to {path}")

            elif cmd == "/rename":
                if not arg:
                    print("usage: /rename <new-name>")
                    continue
                old_name = session["name"]
                save_session(session)  # persist latest content first, then rename as a whole
                ok, result = rename_session_file(old_name, arg)
                if ok:
                    session["name"] = arg
                    print(f'renamed session "{old_name}" to "{arg}"')
                else:
                    print(result)

            elif cmd == "/resume":
                target = arg
                if not target:
                    # No name given: resume the most recently updated session
                    # (excluding the current one)
                    for name, _ in list_sessions():
                        if name != session["name"]:
                            target = name
                            break
                    if not target:
                        print("no session to resume.")
                        continue
                save_session(session)
                loaded = load_session(target)
                if loaded is None:
                    print(f'session "{target}" not found; type /list to see saved sessions.')
                    continue
                session = loaded
                provider = session["provider"]
                # The resumed session may belong to another provider, and the key
                # resolved at startup may not apply; re-resolve against the
                # session's own provider to avoid a 401 from using the wrong key
                resumed_key = resolve_api_key(provider, None, load_config())
                if resumed_key:
                    api_key = resumed_key
                else:
                    env_name = ENV_KEY_NAMES.get(provider, "corresponding env var")
                    print(stylize(f"[note] no API key found for {provider} ({env_name}); "
                                  f"calls in this session will fail", "red"))
                print(f'switched to session "{session["name"]}" provider={provider} model={session["model"]}')

            elif cmd == "/list":
                sessions = list_sessions()
                if not sessions:
                    print("(no saved sessions yet)")
                for name, data in sessions:
                    n_msgs = len(data.get("messages", []))
                    print(f"  - {name}  [{data.get('provider')}/{data.get('model')}]  "
                          f"{n_msgs} messages  updated {data.get('updated_at')}")

            elif cmd == "/new":
                save_session(session)
                new_name = arg or default_session_name()
                # Carry base_url over: openai_responses and similar providers
                # cannot make calls without it
                session = new_session(new_name, provider, session["model"], session["system_prompt"],
                                      base_url=session.get("base_url"))
                print(f'started new session "{new_name}"')

            elif cmd == "/export":
                if not session["messages"]:
                    print("(no conversation yet, nothing to export)")
                    continue
                path, overwritten = export_session(session, arg or None)
                print(f"exported to {path}" + (" (overwrote existing file)" if overwritten else ""))

            elif cmd == "/edit":
                text = _edit_in_editor()
                if text:
                    kb = len(text.encode("utf-8")) // 1024
                    if kb > 100:
                        print(f"(editor content is {kb} KB, sending as a whole)")
                    send_message(session, text, provider, api_key)
                else:
                    print("(empty content, cancelled)")

            elif cmd == "/system":
                if arg:
                    session["system_prompt"] = arg
                    print("system prompt updated.")
                else:
                    print(f"current system prompt: {session['system_prompt'] or '(not set)'}")

            elif cmd == "/model":
                if arg:
                    session["model"] = arg
                    print(f"model switched to: {arg}")
                else:
                    print(f"current model: {session['model']}")

            elif cmd == "/baseurl":
                if arg:
                    session["base_url"] = arg
                    print(f"base url set to: {arg}")
                else:
                    print(f"current base url: {session.get('base_url') or '(not set, provider default)'}")

            elif cmd == "/history":
                msgs = session["messages"]
                if not msgs:
                    print("(no conversation yet in this session)")
                    continue
                if arg:
                    # /history N: only the last N rounds (a round = one Q&A pair)
                    try:
                        n = int(arg)
                        if n <= 0:
                            raise ValueError
                    except ValueError:
                        print("usage: /history [last N rounds]")
                        continue
                    msgs = msgs[-2 * n:]
                    # Align to a user-message boundary so display doesn't start mid-round
                    while msgs and msgs[0]["role"] != "user":
                        msgs = msgs[1:]
                    if len(msgs) < len(session["messages"]):
                        print(f"(showing last {n} rounds only; full history has "
                              f"{len(session['messages'])} messages, /history shows all)")
                _page_text(_format_history(msgs))

            elif cmd == "/clear":
                session["messages"] = []
                print("session history cleared.")

            else:
                print(f"unknown command: {cmd}; type /help for available commands.")

            continue

        # Normal user message -> call the model
        send_message(session, user_input, provider, api_key)


